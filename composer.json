{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "fresapos/backend",
    "type": "project",
    "description": "Base del monolito modular FresaPOS",
    "license": "MIT",
    "require": {
        "php": "~8.3.0",
        "ext-pdo_sqlsrv": "*",
        "ext-sqlsrv": "*",
        "laravel/framework": "^13.42",
        "laravel/sanctum": "^4.4",
        "livewire/livewire": "^4.4.8",
        "nwidart/laravel-modules": "^13.3",
        "spatie/laravel-permission": "^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.14",
        "laravel/pint": "^1.27",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {"psr-4": {"App\\": "app/"}},
    "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "test": "@php vendor/phpunit/phpunit/phpunit",
        "lint": "@php vendor/laravel/pint/builds/pint --test",
        "analyse": "@php vendor/phpstan/phpstan/phpstan analyse --memory-limit=512M"
    },
    "extra": {
        "laravel": {"dont-discover": []},
        "merge-plugin": {"include": ["Modules/*/composer.json"]}
    },
    "config": {
        "platform": {"php": "8.3.36"},
        "allow-plugins": {"wikimedia/composer-merge-plugin": true},
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
