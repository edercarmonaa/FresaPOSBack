APP_NAME=FresaPOS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://CHANGE_ME.example.com
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_PORT=8080
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
DB_CONNECTION=sqlsrv
DB_HOST=CHANGE_ME.database.windows.net
DB_PORT=1433
DB_DATABASE=CHANGE_ME_PRODUCTION_DATABASE
DB_USERNAME=CHANGE_ME_PRODUCTION_USER
DB_PASSWORD=CHANGE_ME_PRODUCTION_PASSWORD
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=no
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
